# Copie ce fichier en ".env" et remplis tes propres valeurs.
# Ne jamais commiter le fichier ".env" réel dans Git !

# Génère une nouvelle clé avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-moi-avec-une-vraie-cle-secrete

# True en local, False en production
DEBUG=True

# Domaines autorisés à servir l'application, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1

# Laisse vide en local (SQLite sera utilisé automatiquement).
# En production, ton hébergeur fournit généralement cette variable automatiquement
# (ex: postgres://utilisateur:motdepasse@hote:5432/nom_base)
DATABASE_URL=
